QPushButton{
    background-color: transparent;
    color: #708084;
    padding: 10px 15px;
    font-family: "Inter";
    font-size: 20pt;
    border:none;
    border-radius: 8px;
} 

QPushButton:hover{
    background-color: #073c47;
    color: #e9fed46a;
}

QPushButton:pressed{
    color: #e9fed46a;
    background-color: transparent;
}

QPushButton:pressed{
    color: #e9fed46a;
}

QMenu,QMenuBar{
    color: #D9D9D9;
    font-size: 14pt;
    background-color:#05313c;
}

QMenu{
    border: 1px solid #be708084;
    border-radius:8px;
}

QMenu::item{
    border: 1px solid #be708084;
    padding-left:8px;
    padding-right:8px;
    padding-top:3px;
    padding-bottom:3px;
}

QMenuBar{
    background-color:#05313c;
}

QMenuBar::item,
QMenuBar::item:hover,
QMenuBar::item:selected{
    padding: 5px 10px;
}

QMenuBar::item:hover,
QMenuBar::item:selected,
QMenu::item:selected
{
    background-color:#05313c;
}

QLineEdit{
    background-color:#05313c;
    border-radius: 20px;
    padding:5px 10px;
    color: #708084;
    font-size: 16pt;
    min-height:10px;
    max-height:50px;
}

QComboBox{
    background-color:#0e4551;
    color: #708084;
    padding: 5px;
    min-width:100px;
    max-width:400px;
    min-height:20px;
    max-height:30px;
    font-size: 16pt;
    border:none;
    border-radius: 10px;
}

#addMedia{
    background-color:#05313c;
    color: #708084;
    border-radius: 8px;
    font-size: 25pt;
    padding: 30px;
    border-radius:35px;
}

#addMedia:pressed{
    color: #0e4551;
}

#latoSinistraSP{
    background-color:#0e4551;
    border-top:2px solid #073c47;
}

#stackModifiche{
    background-color: #073c47;
    border-top:2px solid #073c47;
}

#widegetMedia QPushButton {
    text-align: left;
}

#addMedia:hover{
    color: #e9fed46a;
}

#filtri{
    color: #708084;
    min-height:10px;
    max-height:50px;
}

#invioCerca, #vista{
    background-color:transparent;
    color: #708084;
    min-height:10px;
    max-height:50px;
}

#invioCerca:hover,
#vista:hover,
#filtri:hover{
    color: #e9fed46a;
}

#invioCerca:pressed,
#vista:pressed,
#filtri:pressed{
    color: #e9fed46a;
}

#cinema{
    color:#afc5cc;
    text-align: center;
}

#cinema:hover{
    color:#e9fed46a;
}

#widgetPath{
    background:#fed46a;
    min-height:300px;
    max-height:400px;
    max-width:400px;
    min-width:300px;
    border: 30px dashed #fed46a;
}

